---
import type { Locale } from '../data/site';
import { DICT } from '../data/i18n';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingButtons from './FloatingButtons.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RelatedArticles from './RelatedArticles.astro';
import StickyCTA from './StickyCTA.astro';
import type { Crumb } from '../layouts/Layout.astro';
import { getPost } from '../data/blog';
import type { Treatment } from '../data/treatments';

type Props = {
  treatment: Treatment;
  locale: Locale;
  canonicalPath: string;
  breadcrumbs: Crumb[];
};
const { treatment, locale, canonicalPath, breadcrumbs } = Astro.props;
const t = DICT[locale];
const tp = t.treatmentPage;
const contactPath = `/${locale}/${locale === 'en' ? 'contact' : 'iletisim'}`;

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: treatment.title,
  serviceType: treatment.title,
  provider: { '@type': 'MedicalBusiness', name: 'Hospital365 — Akay Travel' },
  areaServed: ['Urmia', 'Iran'],
  availableLanguage: ['en', 'tr'],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: treatment.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const relatedPost = treatment.relatedPostSlug ? getPost(treatment.relatedPostSlug, locale) : undefined;
---

<Layout
  locale={locale}
  title={treatment.metaTitle}
  metaDescription={treatment.metaDescription}
  canonicalPath={canonicalPath}
  hreflangPath={treatment.hreflangPair ? `/${treatment.hreflangPair}/` : undefined}
  breadcrumbs={breadcrumbs}
  jsonLd={[serviceLd, faqLd]}
>
  <Header locale={locale} currentPath={canonicalPath} />
  <Breadcrumbs locale={locale} crumbs={breadcrumbs} />

  <article class="container-wide pb-16">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-ink-900 sm:text-4xl">{treatment.h1}</h1>
    </header>

    <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-ink-100">
      <img src={treatment.heroImage} alt={treatment.heroImageAlt} class="h-full w-full object-cover" fetchpriority="high" />
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{tp.overview}</h2>
          {treatment.sections.overview.map((p) => <p class="mb-3 text-ink-700">{p}</p>)}
        </section>

        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{tp.cost}</h2>
          <p class="mb-4 text-ink-700">{treatment.sections.cost.intro}</p>
          <table class="w-full overflow-hidden rounded-lg border border-ink-200 text-sm">
            <tbody>
              {treatment.sections.cost.rows.map((row) => (
                <tr class="border-b border-ink-100 last:border-0">
                  <td class="bg-ink-50 px-4 py-3 font-medium text-ink-700">{row.label}</td>
                  <td class="px-4 py-3 text-ink-900">{row.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-3 text-sm text-ink-500">{treatment.sections.cost.note}</p>
        </section>

        <section class="mb-8 grid gap-6 sm:grid-cols-2">
          <div>
            <h2 class="mb-3 text-xl font-bold text-ink-900">{tp.included}</h2>
            <ul class="space-y-2">
              {treatment.sections.included.map((item) => (
                <li class="flex gap-2 text-sm text-ink-700">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-success-500" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 011.4-1.4l3.2 3.2 6.8-6.8a1 1 0 011.4 0z"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2 class="mb-3 text-xl font-bold text-ink-900">{tp.notIncluded}</h2>
            <ul class="space-y-2">
              {treatment.sections.notIncluded.map((item) => (
                <li class="flex gap-2 text-sm text-ink-700">
                  <svg class="mt-0.5 h-4 w-4 flex-shrink-0 text-ink-400" viewBox="0 0 20 20" fill="currentColor"><path d="M4.3 4.3a1 1 0 011.4 0L10 8.6l4.3-4.3a1 1 0 111.4 1.4L11.4 10l4.3 4.3a1 1 0 01-1.4 1.4L10 11.4l-4.3 4.3a1 1 0 01-1.4-1.4L8.6 10 4.3 5.7a1 1 0 010-1.4z"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{tp.recovery}</h2>
          {treatment.sections.recovery.map((p) => <p class="mb-3 text-ink-700">{p}</p>)}
        </section>

        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{tp.process}</h2>
          <ol class="space-y-3">
            {treatment.sections.process.map((step, i) => (
              <li class="flex gap-3">
                <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-primary-600 text-sm font-bold text-white">{i + 1}</span>
                <span class="text-ink-700">{step}</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="mb-8">
          <h2 class="mb-4 text-2xl font-bold text-ink-900">{t.blog.faqHeading}</h2>
          <div class="space-y-3">
            {treatment.faq.map((f) => (
              <details class="group rounded-lg border border-ink-200 bg-white p-4">
                <summary class="cursor-pointer font-medium text-ink-900">{f.q}</summary>
                <p class="mt-3 text-sm text-ink-700">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="sticky top-20 rounded-2xl border border-ink-200 bg-ink-50 p-6">
          <h2 class="text-lg font-bold text-ink-900">{tp.ctaTitle}</h2>
          <p class="mt-2 text-sm text-ink-600">{tp.ctaBody}</p>
          <a href={contactPath} class="btn-primary mt-4 w-full">{tp.ctaButton}</a>
          <a href="https://wa.me/989143403431?text=Hello%20Akay%20Travel" target="_blank" rel="noopener" class="btn-whatsapp mt-2 w-full">{t.blog.stickyWhatsapp}</a>
        </div>
      </aside>
    </div>
  </article>

  {relatedPost && <RelatedArticles locale={locale} postSlugs={[relatedPost.slug]} />}

  <Footer locale={locale} />
  <FloatingButtons />
</Layout>
