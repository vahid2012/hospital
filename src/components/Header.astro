---
import { SITE, type Locale, LANG_NAME } from '../data/site';
import { DICT } from '../data/i18n';
import { treatments } from '../data/treatments';
import { cities } from '../data/cities';

type Props = { locale: Locale; currentPath: string };
const { locale, currentPath } = Astro.props;
const t = DICT[locale];
const dir = locale;

const enTreatments = treatments.filter((x) => x.locale === 'en');
const trTreatments = treatments.filter((x) => x.locale === 'tr');
const enCities = cities.filter((x) => x.locale === 'en');
const trCities = cities.filter((x) => x.locale === 'tr');

const trTreatmentsMap: Record<string, string> = {
  'fertility-ivf-urmia': 'urmia-tup-bebek',
  'cosmetic-surgery-urmia': 'urmia-estetik-cerrahi',
  'dental-treatment-urmia': '',
};
const enTreatmentLabels: Record<string, string> = {
  'fertility-ivf-urmia': t.treatments.fertility,
  'cosmetic-surgery-urmia': t.treatments.cosmetic,
  'dental-treatment-urmia': t.treatments.dental,
};
const trTreatmentLabels: Record<string, string> = {
  'urmia-tup-bebek': t.treatments.fertility,
  'urmia-estetik-cerrahi': t.treatments.cosmetic,
};

const trCitiesMap: Record<string, string> = {
  'urmia-medical-tourism': 'urmia-saglik-turizmi',
  'tabriz-medical-tourism': '',
  'tehran-medical-tourism': '',
  'shiraz-medical-tourism': '',
};
const enCityLabels: Record<string, string> = {
  'urmia-medical-tourism': t.citiesNames.urmia,
  'tabriz-medical-tourism': t.citiesNames.tabriz,
  'tehran-medical-tourism': t.citiesNames.tehran,
  'shiraz-medical-tourism': t.citiesNames.shiraz,
};
const trCityLabels: Record<string, string> = {
  'urmia-saglik-turizmi': t.citiesNames.urmia,
};

const treatmentList =
  locale === 'en'
    ? enTreatments.map((x) => ({ slug: x.slug, label: enTreatmentLabels[x.slug] ?? x.title }))
    : trTreatments.map((x) => ({ slug: x.slug, label: trTreatmentLabels[x.slug] ?? x.title }));
const cityList =
  locale === 'en'
    ? enCities.map((x) => ({ slug: x.slug, label: enCityLabels[x.slug] ?? x.title }))
    : trCities.map((x) => ({ slug: x.slug, label: trCityLabels[x.slug] ?? x.title }));

const treatmentBase = locale === 'en' ? `${dir}/treatments` : `${dir}/tedaviler`;
const cityBase = locale === 'en' ? `${dir}/cities` : `${dir}/sehirler`;
const blogPath = `/${dir}/blog`;
const faqPath = `/${dir}/${locale === 'en' ? 'faq' : 'sss'}`;
const contactPath = `/${dir}/${locale === 'en' ? 'contact' : 'iletisim'}`;
const homePath = `/${dir}/`;

const switchPath = (() => {
  const other = locale === 'en' ? 'tr' : 'en';
  const parts = currentPath.split('/').filter(Boolean);
  if (parts.length === 0 || (parts.length === 1 && (parts[0] === 'en' || parts[0] === 'tr'))) {
    return `/${other}/`;
  }
  if (parts[0] === locale) parts[0] = other;
  return '/' + parts.join('/');
})();
---

<header class="sticky top-0 z-40 border-b border-ink-200 bg-white/95 backdrop-blur">
  <div class="container-wide flex h-16 items-center justify-between gap-4">
    <a href={homePath} class="flex items-center gap-2 text-lg font-bold text-primary-700">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-primary-600 text-white">H</span>
      Hospital365
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <div class="group relative">
        <button class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100" aria-expanded="false">
          {t.nav.treatments}
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 mt-1 w-64 rounded-xl border border-ink-200 bg-white p-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100">
          {treatmentList.map((item) => (
            <a href={`${treatmentBase}/${item.slug}/`} class="block rounded-lg px-3 py-2 text-sm text-ink-700 hover:bg-primary-50 hover:text-primary-700">{item.label}</a>
          ))}
        </div>
      </div>

      <div class="group relative">
        <button class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100" aria-expanded="false">
          {t.nav.cities}
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"/></svg>
        </button>
        <div class="invisible absolute left-0 top-full z-50 mt-1 w-64 rounded-xl border border-ink-200 bg-white p-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100">
          {cityList.map((item) => (
            <a href={`${cityBase}/${item.slug}/`} class="block rounded-lg px-3 py-2 text-sm text-ink-700 hover:bg-primary-50 hover:text-primary-700">{item.label}</a>
          ))}
        </div>
      </div>

      <a href={blogPath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.blog}</a>
      <a href={faqPath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.faq}</a>
      <a href={contactPath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.contact}</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href={switchPath} class="rounded-md border border-ink-200 px-3 py-1.5 text-sm font-semibold text-ink-700 hover:bg-ink-100" aria-label={`Switch to ${LANG_NAME[locale === 'en' ? 'tr' : 'en']}`}>
        {t.nav.switchTo}
      </a>
      <button id="mobile-menu-btn" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-ink-200 text-ink-700 lg:hidden" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-ink-200 bg-white lg:hidden">
    <nav class="container-wide flex flex-col gap-1 py-4" aria-label="Mobile">
      <a href={homePath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.home}</a>
      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">
          {t.nav.treatments}
          <svg class="h-4 w-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"/></svg>
        </summary>
        <div class="pl-4">
          {treatmentList.map((item) => (
            <a href={`${treatmentBase}/${item.slug}/`} class="block rounded-md px-3 py-2 text-sm text-ink-600 hover:bg-primary-50 hover:text-primary-700">{item.label}</a>
          ))}
        </div>
      </details>
      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">
          {t.nav.cities}
          <svg class="h-4 w-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z"/></svg>
        </summary>
        <div class="pl-4">
          {cityList.map((item) => (
            <a href={`${cityBase}/${item.slug}/`} class="block rounded-md px-3 py-2 text-sm text-ink-600 hover:bg-primary-50 hover:text-primary-700">{item.label}</a>
          ))}
        </div>
      </details>
      <a href={blogPath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.blog}</a>
      <a href={faqPath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.faq}</a>
      <a href={contactPath} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-100">{t.nav.contact}</a>
    </nav>
  </div>
</header>

<script is:inline define:vars={{ menuLabel: t.nav.menu, closeLabel: t.nav.close }}>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!open));
      btn.setAttribute('aria-label', open ? menuLabel : closeLabel);
    });
  })();
</script>
