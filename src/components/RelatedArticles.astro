---
import type { Locale } from '../data/site';
import { DICT } from '../data/i18n';
import { blogPosts } from '../data/blog';

type Props = { locale: Locale; postSlugs: string[] };
const { locale, postSlugs } = Astro.props;
const t = DICT[locale];
const posts = blogPosts.filter((p) => p.locale === locale && postSlugs.includes(p.slug));
---

{posts.length > 0 && (
  <section class="container-wide mt-12">
    <h2 class="text-2xl font-bold text-ink-900">{t.blog.relatedTitle}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/${locale}/blog/${post.slug}/`} class="card group flex flex-col">
          <div class="aspect-[16/9] overflow-hidden rounded-xl bg-ink-100">
            <img src={post.featuredImage} alt={post.featuredImageAlt} class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900 group-hover:text-primary-700">{post.title}</h3>
          <p class="mt-2 text-sm text-ink-600">{post.excerpt}</p>
          <span class="mt-3 text-sm font-semibold text-primary-700">{t.blog.readMore} &rarr;</span>
        </a>
      ))}
    </div>
  </section>
)}
