---
import type { Locale } from '../data/site';
import { DICT } from '../data/i18n';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FloatingButtons from './FloatingButtons.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import RelatedArticles from './RelatedArticles.astro';
import type { Crumb } from '../layouts/Layout.astro';
import { getPost } from '../data/blog';
import type { City } from '../data/cities';

type Props = {
  city: City;
  locale: Locale;
  canonicalPath: string;
  breadcrumbs: Crumb[];
};
const { city, locale, canonicalPath, breadcrumbs } = Astro.props;
const t = DICT[locale];
const cp = t.cityPage;
const contactPath = `/${locale}/${locale === 'en' ? 'contact' : 'iletisim'}`;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: city.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const relatedPost = city.relatedPostSlug ? getPost(city.relatedPostSlug, locale) : undefined;
---

<Layout
  locale={locale}
  title={city.metaTitle}
  metaDescription={city.metaDescription}
  canonicalPath={canonicalPath}
  hreflangPath={city.hreflangPair ? `/${city.hreflangPair}/` : undefined}
  breadcrumbs={breadcrumbs}
  jsonLd={[faqLd]}
>
  <Header locale={locale} currentPath={canonicalPath} />
  <Breadcrumbs locale={locale} crumbs={breadcrumbs} />

  <article class="container-wide pb-16">
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-ink-900 sm:text-4xl">{city.h1}</h1>
    </header>

    <div class="aspect-[16/9] overflow-hidden rounded-2xl bg-ink-100">
      <img src={city.heroImage} alt={city.heroImageAlt} class="h-full w-full object-cover" fetchpriority="high" />
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{cp.overview}</h2>
          {city.sections.overview.map((p) => <p class="mb-3 text-ink-700">{p}</p>)}
        </section>

        <section class="mb-8">
          <h2 class="mb-4 text-2xl font-bold text-ink-900">{cp.whyHere}</h2>
          <div class="grid gap-4 sm:grid-cols-2">
            {city.sections.whyHere.map((item) => (
              <div class="rounded-xl border border-ink-200 bg-white p-5">
                <h3 class="font-semibold text-ink-900">{item.title}</h3>
                <p class="mt-2 text-sm text-ink-600">{item.body}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{cp.hospitals}</h2>
          {city.sections.hospitals.map((p) => <p class="mb-3 text-ink-700">{p}</p>)}
        </section>

        <section class="mb-8">
          <h2 class="mb-3 text-2xl font-bold text-ink-900">{cp.travel}</h2>
          {city.sections.travel.map((p) => <p class="mb-3 text-ink-700">{p}</p>)}
        </section>

        {city.externalLink && (
          <section class="mb-8 rounded-xl border border-primary-200 bg-primary-50 p-5">
            <p class="text-sm text-ink-700">
              {city.externalLink.context}{' '}
              <a href={city.externalLink.url} target="_blank" rel="noopener" class="font-semibold text-primary-700 underline hover:text-primary-800">{city.externalLink.anchor}</a>
            </p>
          </section>
        )}

        <section class="mb-8">
          <h2 class="mb-4 text-2xl font-bold text-ink-900">{t.blog.faqHeading}</h2>
          <div class="space-y-3">
            {city.faq.map((f) => (
              <details class="group rounded-lg border border-ink-200 bg-white p-4">
                <summary class="cursor-pointer font-medium text-ink-900">{f.q}</summary>
                <p class="mt-3 text-sm text-ink-700">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      </div>

      <aside class="lg:col-span-1">
        <div class="sticky top-20 rounded-2xl border border-ink-200 bg-ink-50 p-6">
          <h2 class="text-lg font-bold text-ink-900">{cp.ctaTitle}</h2>
          <p class="mt-2 text-sm text-ink-600">{cp.ctaBody}</p>
          <a href={contactPath} class="btn-primary mt-4 w-full">{cp.ctaButton}</a>
          <a href="https://wa.me/989143403431?text=Hello%20Akay%20Travel" target="_blank" rel="noopener" class="btn-whatsapp mt-2 w-full">{t.blog.stickyWhatsapp}</a>
        </div>
      </aside>
    </div>
  </article>

  {relatedPost && <RelatedArticles locale={locale} postSlugs={[relatedPost.slug]} />}

  <Footer locale={locale} />
  <FloatingButtons />
</Layout>
