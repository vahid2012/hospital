---
import CityLayout from '../../../components/CityLayout.astro';
import { getCity } from '../../../data/cities';
import { DICT } from '../../../data/i18n';

const slug = 'urmia-saglik-turizmi';
const locale = 'tr' as const;
const city = getCity(slug, locale);
if (!city) throw new Error(`City ${slug} not found`);
const t = DICT[locale];
const canonicalPath = `/tr/sehirler/${slug}/`;

const breadcrumbs = [
  { name: t.breadcrumb.home, url: '/tr/' },
  { name: t.breadcrumb.cities, url: `/tr/sehirler/${slug}/` },
  { name: city.breadcrumbName, url: canonicalPath },
];
---

<CityLayout city={city} locale={locale} canonicalPath={canonicalPath} breadcrumbs={breadcrumbs} />
