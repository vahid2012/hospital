---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingButtons from '../../components/FloatingButtons.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { DICT } from '../../data/i18n';
import { SITE } from '../../data/site';
import type { Crumb } from '../../layouts/Layout.astro';

const locale = 'tr' as const;
const t = DICT[locale];
const ct = t.contact;
const canonicalPath = '/tr/iletisim/';
const crumbs: Crumb[] = [
  { name: t.breadcrumb.home, url: '/tr/' },
  { name: t.breadcrumb.contact, url: canonicalPath },
];
---

<Layout
  locale={locale}
  title="İletişim — Akay Travel | İran Sağlık Turizmi +98 44 3346 5524"
  metaDescription="Akay Travel ile iletişime geçin. WhatsApp +98 914 340 3431 veya +98 44 3346 5524. Vize, klinik ve otel koordinasyonu."
  canonicalPath={canonicalPath}
  hreflangPath="/en/contact/"
  breadcrumbs={crumbs}
>
  <Header locale={locale} currentPath={canonicalPath} />
  <Breadcrumbs locale={locale} crumbs={crumbs} />

  <main class="container-wide pb-16">
    <h1 class="text-3xl font-bold text-ink-900 sm:text-4xl">{ct.title}</h1>
    <p class="mt-3 max-w-2xl text-ink-600">{ct.subtitle}</p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="space-y-4">
        <div class="card">
          <h2 class="text-lg font-semibold text-ink-900">{ct.phoneLabel}</h2>
          <p class="mt-2 text-ink-700"><a href={`tel:${SITE.phones.office.replace(/\s/g,'')}`} class="hover:text-primary-700">{SITE.phones.officeDisplay}</a></p>
        </div>
        <div class="card">
          <h2 class="text-lg font-semibold text-ink-900">{ct.whatsappLabel}</h2>
          <p class="mt-2 text-ink-700"><a href={SITE.whatsappLink} target="_blank" rel="noopener" class="hover:text-primary-700">{SITE.phones.whatsappDisplay}</a></p>
          <a href={SITE.whatsappLink} target="_blank" rel="noopener" class="btn-whatsapp mt-3">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607z"/></svg>
            WhatsApp
          </a>
        </div>
        <div class="card">
          <h2 class="text-lg font-semibold text-ink-900">{ct.instagramLabel}</h2>
          <p class="mt-2 text-ink-700"><a href={SITE.instagram} target="_blank" rel="noopener" class="hover:text-primary-700">@{SITE.instagramHandle}</a></p>
        </div>
      </div>

      <div class="card">
        <h2 class="text-lg font-semibold text-ink-900">{ct.formTitle}</h2>
        <form id="contact-form" class="mt-4 space-y-4" onsubmit="return false;">
          <div>
            <label for="name" class="block text-sm font-medium text-ink-700">{ct.formName}</label>
            <input id="name" name="name" type="text" required class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-primary-500" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-ink-700">{ct.formEmail}</label>
            <input id="email" name="email" type="email" required class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-primary-500" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-ink-700">{ct.formPhone}</label>
            <input id="phone" name="phone" type="tel" class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-primary-500" />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-ink-700">{ct.formMessage}</label>
            <textarea id="message" name="message" rows="4" required class="mt-1 block w-full rounded-lg border border-ink-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-primary-500"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">{ct.formSubmit}</button>
          <p class="text-xs text-ink-500">{ct.formNote}</p>
        </form>
      </div>
    </div>
  </main>

  <Footer locale={locale} />
  <FloatingButtons />
</Layout>

<script is:inline define:vars={{ waLink: SITE.whatsappLink }}>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = (document.getElementById('name') || {}).value || '';
      var email = (document.getElementById('email') || {}).value || '';
      var phone = (document.getElementById('phone') || {}).value || '';
      var message = (document.getElementById('message') || {}).value || '';
      var text = 'Name: ' + name + '\nEmail: ' + email + '\nPhone: ' + phone + '\n\n' + message;
      window.open(waLink + encodeURIComponent('\n' + text), '_blank');
    });
  })();
</script>
