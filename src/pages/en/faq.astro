---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FloatingButtons from '../../components/FloatingButtons.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { DICT } from '../../data/i18n';
import { faqData } from '../../data/faq';
import type { Crumb } from '../../layouts/Layout.astro';

const locale = 'en' as const;
const t = DICT[locale];
const canonicalPath = '/en/faq/';
const crumbs: Crumb[] = [
  { name: t.breadcrumb.home, url: '/en/' },
  { name: t.breadcrumb.faq, url: canonicalPath },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData[locale].map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  locale={locale}
  title="FAQ — Medical Tourism in Iran | Akay Travel +98 44 3346 5524"
  metaDescription="Frequently asked questions about medical tourism in Iran with Akay Travel. Treatments, visas, costs and safety. Call +98 44 3346 5524."
  canonicalPath={canonicalPath}
  hreflangPath="/tr/sss/"
  breadcrumbs={crumbs}
  jsonLd={[faqLd]}
>
  <Header locale={locale} currentPath={canonicalPath} />
  <Breadcrumbs locale={locale} crumbs={crumbs} />

  <main class="container-prose pb-16">
    <h1 class="text-3xl font-bold text-ink-900 sm:text-4xl">{t.faq.title}</h1>
    <p class="mt-3 text-ink-600">{t.faq.subtitle}</p>

    <div class="mt-8 space-y-3">
      {faqData[locale].map((f) => (
        <details class="group rounded-lg border border-ink-200 bg-white p-4">
          <summary class="cursor-pointer font-medium text-ink-900">{f.q}</summary>
          <p class="mt-3 text-sm text-ink-700">{f.a}</p>
        </details>
      ))}
    </div>
  </main>

  <Footer locale={locale} />
  <FloatingButtons />
</Layout>
