---
import BlogPostLayout from '../../../components/BlogPostLayout.astro';
import { getPost } from '../../../data/blog';
import { DICT } from '../../../data/i18n';

const slug = 'ivf-treatment-in-iran-cost';
const locale = 'en' as const;
const post = getPost(slug, locale);
if (!post) throw new Error(`Post ${slug} not found`);
const t = DICT[locale];
const canonicalPath = `/en/blog/${slug}/`;

const breadcrumbs = [
  { name: t.breadcrumb.home, url: '/en/' },
  { name: t.breadcrumb.blog, url: '/en/blog/' },
  { name: post.breadcrumbName, url: canonicalPath },
];
---

<BlogPostLayout post={post} locale={locale} canonicalPath={canonicalPath} breadcrumbs={breadcrumbs} />
