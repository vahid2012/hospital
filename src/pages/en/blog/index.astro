---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FloatingButtons from '../../../components/FloatingButtons.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { DICT } from '../../../data/i18n';
import { getPostsByLocale } from '../../../data/blog';
import type { Crumb } from '../../../layouts/Layout.astro';

const locale = 'en' as const;
const t = DICT[locale];
const canonicalPath = '/en/blog/';
const crumbs: Crumb[] = [
  { name: t.breadcrumb.home, url: '/en/' },
  { name: t.breadcrumb.blog, url: canonicalPath },
];
const posts = getPostsByLocale(locale);
---

<Layout
  locale={locale}
  title="Blog & Patient Guides | Medical Tourism in Iran — Akay Travel"
  metaDescription="Patient guides on IVF, cosmetic surgery and dental treatment in Iran. Costs, recovery and travel tips from Akay Travel. Call +98 44 3346 5524."
  canonicalPath={canonicalPath}
  hreflangPath="/tr/blog/"
  breadcrumbs={crumbs}
>
  <Header locale={locale} currentPath={canonicalPath} />
  <Breadcrumbs locale={locale} crumbs={crumbs} />

  <main class="container-wide pb-16">
    <h1 class="text-3xl font-bold text-ink-900 sm:text-4xl">{t.blog.title}</h1>
    <p class="mt-3 max-w-2xl text-ink-600">{t.blog.subtitle}</p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {posts.map((post) => (
        <a href={`/en/blog/${post.slug}/`} class="card group flex flex-col">
          <div class="aspect-[16/9] overflow-hidden rounded-xl bg-ink-200">
            <img src={post.featuredImage} alt={post.featuredImageAlt} class="h-full w-full object-cover transition group-hover:scale-105" loading="lazy" />
          </div>
          <p class="mt-4 text-xs text-ink-500">{post.dateDisplay} · {post.author}</p>
          <h2 class="mt-1 text-xl font-bold text-ink-900 group-hover:text-primary-700">{post.title}</h2>
          <p class="mt-2 text-sm text-ink-600">{post.excerpt}</p>
          <span class="mt-3 text-sm font-semibold text-primary-700">{t.blog.readMore} &rarr;</span>
        </a>
      ))}
    </div>
  </main>

  <Footer locale={locale} />
  <FloatingButtons />
</Layout>
